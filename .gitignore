# ─── Container data directories ────────────────────────────────────────────
# Chat history, uploaded documents, RAG vectors, character cards, personas.
# These are yours, they get large, and they are not reproducible artifacts.
*-data/
open-webui-data/
sillytavern-data/

# ─── Secrets and local configuration ───────────────────────────────────────
# SillyTavern requires credentials to start; sillytavern/.env.example documents
# the variable names. Live .env files never get committed.
.env
.env.*
!.env.example
config.toml
*.key
*.pem
secrets.yml

# ─── Model weights ─────────────────────────────────────────────────────────
# Models are downloaded through LM Studio, never vendored into a git repo.
*.gguf
*.safetensors
*.bin

# ─── Benchmark scratch output ──────────────────────────────────────────────
# Raw runs land here; curated results are committed to benchmarks/ by hand.
# The harness writes results.json beside itself unless told otherwise, so the
# filenames it produces are ignored wherever they land.
benchmarks/raw/
results*.json
run-*.md
*.log

# ─── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
._*

# ─── Editors ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
