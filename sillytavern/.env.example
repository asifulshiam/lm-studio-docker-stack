# Copy to .env beside the Compose file, then set both values.
#
# These have no defaults on purpose. SillyTavern refuses to start when it is
# listening beyond localhost without authentication, and shipping working
# default credentials in a public repo is how they end up in someone's exposed
# deployment. The Compose file uses ${VAR:?message} so a missing value fails
# loudly at startup rather than quietly weakening the setup.
#
# .env is excluded from version control; this example file is not.

SILLYTAVERN_USER=
SILLYTAVERN_PASSWORD=

# Optional — defaults shown. Uncomment to override.
# SILLYTAVERN_PORT=8000
# SILLYTAVERN_DATA=./sillytavern-data
# SILLYTAVERN_NAME=sillytavern
